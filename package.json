{
  "name": "image-blob-reduce",
  "version": "4.1.0",
  "description": "High quality image resize in browser for blobs (`pica` wrapper with some sugar)",
  "keywords": [
    "resize",
    "scale",
    "image",
    "lanczos",
    "canvas",
    "blob"
  ],
  "repository": "nodeca/image-blob-reduce",
  "license": "MIT",
  "funding": [
    {
      "type": "github",
      "url": "https://github.com/sponsors/puzrin"
    },
    {
      "type": "github",
      "url": "https://github.com/sponsors/nodeca"
    }
  ],
  "files": [
    "lib/",
    "dist/"
  ],
  "main": "./dist/image-blob-reduce.js",
  "module": "./lib/index.mjs",
  "exports": {
    "./package.json": "./package.json",
    "./dist/image-blob-reduce.js": "./dist/image-blob-reduce.js",
    "./lib/image_traverse.mjs": "./lib/image_traverse.mjs",
    ".": "./lib/index.mjs"
  },
  "scripts": {
    "test": "npm run lint && npm run build && npm run test:unit && vitest run --project browser && vitest run --project dist",
    "test:unit": "vitest run --project unit",
    "test:browser": "npm run build && vitest run --project browser",
    "test:dist": "npm run build && vitest run --project dist",
    "lint": "eslint .",
    "demo": "vite --host 127.0.0.1",
    "build": "vite build",
    "build:demo": "vite build --mode demo",
    "gh-pages": "npm run build:demo && gh-pages -d .gh-pages -f",
    "prepublishOnly": "npm run build && npm run gh-pages"
  },
  "dependencies": {
    "pica": "^10.0.0"
  },
  "devDependencies": {
    "@vitest/browser": "^4.1.6",
    "@vitest/browser-playwright": "^4.1.6",
    "eslint": "^9",
    "gh-pages": "^6.3.0",
    "neostandard": "^0.13.0",
    "playwright": "^1.60.0",
    "vite": "^8.0.13",
    "vitest": "^4.1.6"
  }
}
